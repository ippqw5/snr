digraph path_bounce {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.28, nodesep=0.30, ranksep=0.28,
         fontname="Arial", fontsize=18, labelloc=t,
         label="The path loop inside one sample\nThe entire path runs in one GPU compute thread"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#94a3b8",
        fontcolor="#17283b", fontname="Arial", fontsize=13, margin="0.16,0.09"];
  edge [color="#60758a", fontcolor="#334e68", fontname="Arial", fontsize=11, arrowsize=0.7];
  start [label="Camera sample\nBegin a path with no collected radiance"];
  query [label="Hardware ray query\ntraceScene(): does the path hit a surface?"];
  surface [label="Shared surface evaluation\nsurfaceAt(): geometry and material"];
  emission [label="Account for medium absorption and interfaces\nCollect material emission with MIS weighting"];
  nee [label="If NEE is enabled and lights are sampleable\nSelect light → shadow ray → evaluate BSDF\nCollect visible direct light (MIS for area lights)"];
  bsdf [label="Choose reflection or transmission\nsampleBsdf(): continue with a valid path"];
  state [label="Update the path state\nTrack volume boundary crossings\nUpdate scattering throughput"];
  stop [label="Apply path termination\nRussian roulette and the depth limit bound work"];
  miss [label="Miss: collect environment light\nWeight the contribution by path throughput", fillcolor="#edf5ed"];
  result [label="Return the sample's radiance\nAccumulate the sample in Film", fillcolor="#edf5ed"];
  start -> query;
  query -> surface [label="Hit"];
  query -> miss [label="Miss"];
  surface -> emission -> nee -> bsdf;
  bsdf -> state [label="Valid"];
  bsdf -> result [label="Terminate"];
  state -> stop;
  stop -> query [style=dashed, label="Next bounce", constraint=false];
  stop -> result [label="Terminate / depth limit"];
  miss -> result;
}
